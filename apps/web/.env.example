# ---------------------------------------------------------------------------
# Plataforma Hub - Web (Next.js)
# ---------------------------------------------------------------------------

# URL da API. Usada apenas no servidor (Server Components, middleware e BFF).
# O browser nunca fala direto com a API: todas as chamadas passam por /api/bff.
API_URL="http://localhost:5010/api/v1"

# Marque como true apenas quando servir por HTTPS (define cookies Secure).
COOKIE_SECURE=false
