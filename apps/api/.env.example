# ---------------------------------------------------------------------------
# Plataforma Hub - API
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5010

# Banco de dados (docker compose da raiz sobe o Postgres em 5442)
DATABASE_URL="postgresql://hub:hub@localhost:5442/plataforma_hub?schema=public"
# Banco usado pelos testes de integracao (criado automaticamente pelo jest)
TEST_DATABASE_URL="postgresql://hub:hub@localhost:5442/plataforma_hub_test?schema=public"

# Autenticacao - troque o segredo em qualquer ambiente que nao seja local.
# O refresh token e opaco (random) e guardado com hash no banco, por isso
# nao existe segredo de assinatura para ele.
JWT_ACCESS_SECRET="dev-access-secret-change-me-with-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=2592000

# CORS: origens permitidas separadas por virgula (o frontend fala via BFF,
# entao em producao normalmente nenhuma origem de browser precisa ser liberada)
CORS_ORIGINS="http://localhost:3000"

# Swagger
SWAGGER_ENABLED=true
