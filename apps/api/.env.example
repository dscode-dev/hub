# ---------------------------------------------------------------------------
# Plataforma Hub - API
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
# Loopback: o backend desktop nao deve escutar na rede local
HOST=127.0.0.1

# Banco de dados local (SQLite).
# Em desenvolvimento fica no proprio workspace; no aplicativo instalado o
# caminho e injetado pelo Electron e aponta para o diretorio de dados do usuario.
DATABASE_URL="file:./dev.db"

# Autenticacao - troque o segredo em qualquer ambiente que nao seja local.
# O refresh token e opaco (random) e guardado com hash no banco, por isso
# nao existe segredo de assinatura para ele.
JWT_ACCESS_SECRET="dev-access-secret-change-me-with-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=2592000

# CORS: origens permitidas separadas por virgula.
# Dev: dev server do Next. O renderer empacotado (hub://app) e liberado
# automaticamente quando o Electron inicia o backend (HUB_DESKTOP=1).
CORS_ORIGINS="http://localhost:3000"

# Swagger
SWAGGER_ENABLED=true
