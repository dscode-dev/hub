// Plataforma Hub - schema local (SQLite).
//
// A instalacao desktop e local-first: o banco vive no diretorio de dados do
// usuario e o NestJS e o unico processo que o acessa.
//
// Regras adotadas em todo o schema:
//  * Toda entidade operacional carrega organizationId (isolamento multi-tenant).
//    Mantido mesmo no desktop: e o que torna sincronizacao e import/export
//    viaveis no futuro sem remodelar nada.
//  * Identificadores sao UUID gerados pela aplicacao, nunca autoincremento.
//    IDs globalmente unicos evitam colisao numa futura sincronizacao.
//  * Unicidade de dados de negocio e por tenant, nunca global.
//  * Nada e apagado fisicamente no dominio operacional: usamos active=false.
//
// Adaptacoes exigidas pelo SQLite (ver README):
//  * Valores monetarios e quantidades sao INTEIROS. SQLite nao tem tipo decimal
//    real - DECIMAL cai em afinidade NUMERIC e vira ponto flutuante, que
//    acumula erro em somas. Dinheiro em centavos elimina isso por construcao.
//  * Listas escalares nao existem: campos multivalorados sao JSON em texto.
//  * Atributos nativos (@db.Uuid, @db.VarChar) nao se aplicam.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SELLER
  FINANCE
  STOCK
  DELIVERY
  VIEWER
}

/// Tipos de movimentacao.
///
/// Deliberadamente semanticos: `IN`/`OUT` genericos destruiriam a capacidade de
/// responder "por que o saldo mudou" - que e o proposito do ledger. Alguns
/// tipos ainda nao tem origem nesta etapa, mas ja existem para que o historico
/// nao precise ser reinterpretado quando vendas e compras chegarem.
enum InventoryMovementType {
  INITIAL_STOCK

  PURCHASE
  SALE

  SALE_RETURN
  PURCHASE_RETURN

  ADJUSTMENT_IN
  ADJUSTMENT_OUT

  DAMAGE
  LOSS

  INVENTORY_GAIN
  INVENTORY_LOSS

  TRANSFER_IN
  TRANSFER_OUT

  OTHER_IN
  OTHER_OUT
}

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ImportJobStatus {
  DRAFT
  COMPLETED
  FAILED
}

/// Marca que o primeiro acesso desta instalacao ja foi concluido.
///
/// FONTE CANONICA de "instalacao inicializada". Nao existe flag paralela em
/// outra tabela: duas fontes para a mesma verdade divergem no primeiro backup
/// restaurado pela metade. Regra de negocio da empresa mora na Organization;
/// esta tabela responde apenas "ja passou pelo primeiro acesso?".
///
/// Existe como tabela (e nao como flag em memoria ou arquivo externo) porque a
/// garantia precisa vir do banco: `id` tem valor fixo, entao duas requisicoes
/// simultaneas de setup disputam a MESMA chave primaria e apenas uma insere.
model InstanceSetup {
  /// Sempre "singleton". A chave fixa e o proprio mecanismo de exclusao.
  id             String   @id
  organizationId String
  userId         String
  completedAt    DateTime @default(now())

  @@map("instance_setup")
}

/// Unidade de medida.
///
/// `organizationId` nulo = unidade padrao do sistema, disponivel para todas as
/// organizacoes e criada pela migration. Unidades proprias do tenant continuam
/// possiveis pelo mesmo modelo, sem migration nova.
model UnitOfMeasure {
  id             String  @id @default(uuid())
  organizationId String?

  code   String
  name   String
  symbol String

  /// Define se o campo de quantidade aceita casas decimais na interface.
  /// "1,5 kg" faz sentido; "1,5 unidades" normalmente nao.
  allowsFraction Boolean @default(false)
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@map("units_of_measure")
}

/// Empresa cliente. Raiz de todo isolamento de dados.
model Organization {
  id        String  @id @default(uuid())
  name      String
  tradeName String?
  document  String?
  email     String?
  phone     String?

  /// Endereco em colunas explicitas (e nao JSON) porque sera impresso em
  /// documentos e recibos, e precisa ser consultavel campo a campo.
  addressZipCode    String?
  addressStreet     String?
  addressNumber     String?
  addressComplement String?
  addressDistrict   String?
  addressCity       String?
  addressState      String?
  /// Ponto de referencia: so o cliente sabe informar, nunca vem do CEP.
  addressReference  String?

  /// Logo em data URL. Guardar no banco mantem a instalacao autocontida -
  /// sem caminho de arquivo que quebra ao mover ou reinstalar o aplicativo.
  logo String?

  /// Listas em JSON: SQLite nao suporta lista escalar. A conversao acontece
  /// no mapper, entao o dominio continua enxergando arrays tipados.
  segments       String @default("[]")
  operationGoals String @default("[]")

  onboardingCompletedAt DateTime?

  /// Politica de estoque: por padrao uma saida nao pode derrubar o saldo
  /// abaixo de zero. Fica na Organization (e nao numa tabela de settings)
  /// porque e regra de negocio do tenant, nao configuracao tecnica.
  allowNegativeInventory Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories      Category[]
  products        Product[]
  units           UnitOfMeasure[]
  auditLogs       AuditLog[]
  importJobs      ImportJob[]
  movements       InventoryMovement[]
  balances        InventoryBalance[]
  inventoryCounts InventoryCount[]

  @@index([document])
  @@map("organizations")
}

model User {
  id             String @id @default(uuid())
  organizationId String

  name         String
  /// Global unico: o login e feito apenas com e-mail + senha, sem seletor de tenant.
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
  movements     InventoryMovement[]

  @@index([organizationId, active])
  @@map("users")
}

/// Refresh tokens sao persistidos com hash para permitir rotacao e logout real.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  /// SHA-256 do token; o valor puro so existe no cofre do processo principal.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Category {
  id             String @id @default(uuid())
  organizationId String

  name        String
  /// Nome sem acento, minusculo e com espacos colapsados.
  /// O SQLite compara texto byte a byte: sem esta coluna, "Eletronicos",
  /// "eletronicos" e "ELETRONICOS" seriam tres categorias distintas.
  nameNormalized String
  description    String?
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, nameNormalized])
  @@index([organizationId, active])
  @@map("categories")
}

/// Produto generico: serve para movel, eletronico, material de construcao etc.
/// Atributos especificos de nicho devem entrar depois via tabela de atributos,
/// nunca como colunas dedicadas aqui.
model Product {
  id             String  @id @default(uuid())
  organizationId String
  categoryId     String?
  unitId         String?

  name        String
  /// Nome normalizado (sem acento, minusculo). Faz "sofa" encontrar "SOFÁ".
  searchName  String
  sku         String?
  /// SKU normalizado: a unicidade e case-insensitive, entao "ABC1" e "abc1"
  /// sao o mesmo codigo. O valor original e preservado em `sku`.
  skuNormalized String?
  barcode       String?
  description   String?

  /// Dinheiro em CENTAVOS (inteiro). Ver nota no topo do arquivo.
  costPriceCents Int?
  salePriceCents Int

  active         Boolean @default(true)
  trackInventory Boolean @default(false)

  /// Nivel de alerta, em MILESIMOS. E configuracao do produto - o saldo em si
  /// nunca mora aqui: ele e consequencia do ledger (ver InventoryMovement).
  minimumStockMilli Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit         UnitOfMeasure? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  balance    InventoryBalance?
  movements  InventoryMovement[]
  countItems InventoryCountItem[]

  // SKU e codigo de barras sao unicos por tenant, nunca globalmente.
  @@unique([organizationId, skuNormalized])
  @@unique([organizationId, barcode])
  @@index([organizationId, active])
  @@index([organizationId, categoryId])
  @@index([organizationId, searchName])
  @@index([organizationId, barcode])
  @@map("products")
}

/// Trilha de auditoria minima. Sem event sourcing neste momento.
model AuditLog {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?

  action   String
  entity   String
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
  @@map("audit_logs")
}

/// Importacao de CSV: o arquivo enviado fica guardado ate a confirmacao,
/// permitindo mapear colunas e revisar o preview sem reenviar o arquivo.
model ImportJob {
  id             String  @id @default(uuid())
  organizationId String
  userId         String?

  filename String
  status   ImportJobStatus @default(DRAFT)

  /// Conteudo bruto do CSV. Suficiente para arquivos de PME; volumes maiores
  /// devem migrar para armazenamento em disco + processamento assincrono.
  rawContent   String
  columns      Json
  fieldMapping Json?

  totalRows   Int   @default(0)
  createdRows Int   @default(0)
  failedRows  Int   @default(0)
  errors      Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

/// LEDGER DE ESTOQUE - fonte auditavel do saldo.
///
/// Invariantes:
///  * IMUTAVEL: nunca editar quantidade nem apagar linha. Erro se corrige com
///    movimento compensatorio, para o historico continuar explicando o saldo.
///  * ASSINADO: entrada positiva, saida negativa. Assim `SUM(quantityMilli)`
///    e o saldo, sem precisar interpretar tipo nem direcao.
///  * TRANSACIONAL: criado sempre junto da atualizacao de InventoryBalance.
///
/// O objetivo nao e responder "ha 13 unidades", e sim "por que ha 13".
model InventoryMovement {
  id             String @id @default(uuid())
  organizationId String
  productId      String

  type InventoryMovementType

  /// MILESIMOS, com sinal. Entrada > 0, saida < 0. Nunca zero.
  quantityMilli Int

  /// Saldo logo apos este movimento.
  ///
  /// Gravado dentro da mesma transacao que o calculou. Permite montar o
  /// extrato ("saldo apos") sem window function nem recalculo acumulado a
  /// cada leitura - e o valor e historicamente fiel, nao reconstruido.
  balanceAfterMilli Int

  /// Custo unitario no momento da entrada, quando conhecido.
  unitCostCents Int?

  /// Origem do movimento (SALE/saleId, INVENTORY_COUNT/countId...).
  /// Texto livre de proposito: evita FK para dominios que ainda nao existem.
  referenceType String?
  referenceId   String?

  reason String?
  notes  String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Extrato de um produto, do mais recente para o mais antigo.
  @@index([organizationId, productId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

/// Saldo atual - PROJECAO derivada do ledger, nunca fonte isolada de verdade.
///
/// Existe por desempenho: o PDV vai consultar saldo a cada item lido, e somar
/// o ledger inteiro a cada leitura nao escala. Atualizada na MESMA transacao
/// do movimento, entao nunca diverge; se divergir, o ledger vence.
model InventoryBalance {
  id             String @id @default(uuid())
  organizationId String
  /// Unico: um saldo por produto (relacao 1-1).
  productId      String @unique

  quantityMilli  Int       @default(0)
  lastMovementAt DateTime?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, quantityMilli])
  @@map("inventory_balances")
}

/// Inventario fisico (contagem).
model InventoryCount {
  id             String @id @default(uuid())
  organizationId String

  status InventoryCountStatus @default(DRAFT)

  /// Como os produtos entraram na contagem: ALL, CATEGORY ou SELECTION.
  scope      String
  categoryId String?
  notes      String?

  createdByUserId   String?
  completedByUserId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InventoryCountItem[]

  @@index([organizationId, status, createdAt])
  @@map("inventory_counts")
}

model InventoryCountItem {
  id      String @id @default(uuid())
  countId String

  productId String

  /// SNAPSHOT do saldo no momento em que o item entrou na contagem.
  ///
  /// Nunca recalculado depois: e ele que torna a comparacao "sistema x fisico"
  /// honesta, e e contra ele que detectamos conflito na conclusao (se o saldo
  /// atual divergir, houve movimento durante a contagem).
  expectedQuantityMilli Int

  countedQuantityMilli Int?
  countedAt            DateTime?

  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
  @@index([countId])
  @@map("inventory_count_items")
}
