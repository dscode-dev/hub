{
  "name": "plataforma-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Hub - aplicacao desktop de gestao operacional, estoque, vendas e PDV",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,desktop -c blue,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:api": "npm run dev --workspace=@hub/api",
    "dev:web": "npm run dev --workspace=@hub/web",
    "dev:desktop": "wait-on http://localhost:3000 && npm run dev --workspace=@hub/desktop",
    "build:shared": "npm run build --workspace=@hub/shared",
    "build:api": "npm run build --workspace=@hub/api",
    "build:web": "npm run build --workspace=@hub/web",
    "build:desktop": "npm run build --workspace=@hub/desktop",
    "build": "npm run build:shared && npm run build:api && npm run build:web && npm run build:desktop",
    "desktop": "npm run start --workspace=@hub/desktop",
    "package": "npm run build && npm run package --workspace=@hub/desktop",
    "package:dir": "npm run build && npm run package:dir --workspace=@hub/desktop",
    "lint": "npm run lint --workspace=@hub/api && npm run lint --workspace=@hub/web && npm run lint --workspace=@hub/desktop",
    "test": "npm run test --workspace=@hub/api",
    "db:migrate": "npm run db:migrate --workspace=@hub/api",
    "db:seed": "npm run db:seed --workspace=@hub/api",
    "db:studio": "npm run db:studio --workspace=@hub/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true,
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
